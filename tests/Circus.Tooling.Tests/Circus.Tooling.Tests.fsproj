<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RootNamespace>Circus.Tooling.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestDoubles.fs" />
    <Compile Include="SourcePolicy/LineCountingTests.fs" />
    <Compile Include="SourcePolicy/ClassificationTests.fs" />
    <Compile Include="SourcePolicy/ShebangTests.fs" />
    <Compile Include="SourcePolicy/ShellPolicyTests.fs" />
    <Compile Include="SourcePolicy/InvocationPolicyTests.fs" />
    <Compile Include="SourcePolicy/BaselineTests.fs" />
    <Compile Include="SourcePolicy/PathsTests.fs" />
    <Compile Include="SourcePolicy/DeterminismTests.fs" />
    <Compile Include="SourcePolicy/CliTests.fs" />
    <Compile Include="SourcePolicy/NulInventoryTests.fs" />
    <Compile Include="SourcePolicy/ProcessRunnerTests.fs" />
    <Compile Include="SourcePolicy/GateSummaryTests.fs" />
    <Compile Include="SourcePolicy/GateSummaryVerifyTests.fs" />
    <Compile Include="SourcePolicy/GateSummaryWiringTests.fs" />

    <Compile Include="SourcePolicy/ContainerPolicyTests.fs" />
    <Compile Include="SourcePolicy/ContainerPolicyMutationRegistry.fs" />
    <Compile Include="SourcePolicy/ContainerPolicyMutationCases.fs" />
    <Compile Include="SourcePolicy/ContainerPolicyMutationTests.fs" />
    <Compile Include="SourcePolicy/ParityTests.fs" />

    <Compile Include="NoForcePush/InventoryTests.fs" />
    <Compile Include="NoForcePush/CommandLexerTests.fs" />
    <Compile Include="NoForcePush/StaticPolicyTests.fs" />
    <Compile Include="NoForcePush/MutationTests.fs" />
    <Compile Include="NoForcePush/PrePushTests.fs" />
    <Compile Include="NoForcePush/GitHubRulesTests.fs" />
    <Compile Include="NoForcePush/CliTests.fs" />
    <Compile Include="NoForcePush/GateWiringTests.fs" />

    <Compile Include="FSharpDiagnostics/HashingTests.fs" />
    <Compile Include="FSharpDiagnostics/NormalizationTests.fs" />
    <Compile Include="FSharpDiagnostics/OccurrenceIdentityTests.fs" />
    <Compile Include="FSharpDiagnostics/LegacyTextExtractorTests.fs" />
    <Compile Include="FSharpDiagnostics/AtomicPublishTests.fs" />
    <Compile Include="FSharpDiagnostics/BinlogExtractorTests.fs" />
    <Compile Include="FSharpDiagnostics/ManifestIntegrityTests.fs" />
    <Compile Include="FSharpDiagnostics/RepairEpisodes/GitIdentityTests.fs" />
    <Compile Include="FSharpDiagnostics/RepairEpisodes/TransitionTests.fs" />
    <Compile Include="FSharpDiagnostics/RepairEpisodes/DeclarationTests.fs" />
    <Compile Include="FSharpDiagnostics/RepairEpisodes/OccurrenceReaderTests.fs" />
    <Compile Include="FSharpDiagnostics/RepairEpisodes/CaptureBindingTests.fs" />
    <Compile Include="FSharpDiagnostics/RepairEpisodes/BoundedProcessTests.fs" />
    <Compile Include="FSharpDiagnostics/RepairEpisodes/GitAdapterTests.fs" />

    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Circus.Tooling\Circus.Tooling.fsproj" />
  </ItemGroup>

  <!--
    BoundedProcess authority tests require a precompiled F# fixture
    executable that BoundedProcess can launch as a child process. The
    fixture is built as a standalone project (no apphost) and its
    assembly plus runtimeconfig.json are copied into this test
    project's output directory so `AppContext.BaseDirectory` resolves
    a stable, cross-platform path.

    The project reference is declared with
    `ReferenceOutputAssembly="false"` so the fixture assembly is
    *built* but never loaded into the test process. Each BoundedProcess
    authority test launches the fixture as a separate `dotnet` process
    via `dotnet <fixture.dll> <mode> ...`. Loading the fixture into
    the test process would hold the DLL mapped and create a transient
    `BoundedProcess` lifetime risk that has nothing to do with the
    production lifecycle under test.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Circus.Tooling.ProcessTreeFixture\Circus.Tooling.ProcessTreeFixture.fsproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="None"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!--
    Copy the fixture's bare managed assembly and its runtimeconfig.json
    into the test output directory. The runtimeconfig.json is required
    for `dotnet <fixture.dll>` to identify the framework; the assembly
    is the managed code under test.
  -->
  <Target Name="CopyProcessTreeFixture"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Circus.Tooling.ProcessTreeFixture\bin\$(Configuration)\net10.0\circus-process-tree-fixture.dll')">
    <ItemGroup>
      <_ProcessTreeFixtureFiles Include="..\Circus.Tooling.ProcessTreeFixture\bin\$(Configuration)\net10.0\circus-process-tree-fixture.dll" />
      <_ProcessTreeFixtureFiles Include="..\Circus.Tooling.ProcessTreeFixture\bin\$(Configuration)\net10.0\circus-process-tree-fixture.runtimeconfig.json"
                               Condition="Exists('..\Circus.Tooling.ProcessTreeFixture\bin\$(Configuration)\net10.0\circus-process-tree-fixture.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProcessTreeFixtureFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
