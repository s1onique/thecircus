<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Circus.Tooling.ProcessTreeFixture</RootNamespace>
    <AssemblyName>circus-process-tree-fixture</AssemblyName>
    <!-- Apphost is disabled: the fixture is launched via
         `dotnet <fixture.dll> <mode> ...` so the bare managed
         assembly plus its runtimeconfig.json are the only
         artifacts the parent test process needs to copy.  This
         keeps the cross-platform fixture path invariant and
         avoids platform-specific native launcher characters. -->
    <UseAppHost>false</UseAppHost>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

</Project>
